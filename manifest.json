{
  "manifest_version": 3,
  "name": "YouTube Clock",
  "version": "1.1",
  "description": "Permanently tracks daily YouTube watch time with badge icons, screen overlays, and custom break reminders.",
  "author": "Derek Thatcher, Coen and Gemini Flash",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "YouTube Clock",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}